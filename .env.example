# Application
APP_NAME=Pulse
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pulse
AUTO_CREATE_TABLES=false
AUTO_MIGRATE=false

# Authentication
# Generate a long, unique value before deploying. Example:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Browser clients allowed to call the API (Phase 6)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Market data provider (used in a later phase)
MARKET_DATA_PROVIDER=alpha_vantage
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=https://www.alphavantage.co/query
MARKET_DATA_TIMEOUT_SECONDS=10
MARKET_DATA_MAX_AGE_SECONDS=300
